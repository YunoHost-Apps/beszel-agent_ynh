[Unit]
Description=Beszel Agent
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/
ExecStart=__INSTALL_DIR__/beszel-agent
Environment="DATA_DIR=__DATA_DIR__"
Environment="LISTEN=__PORT__"
Environment="KEY=__PUBLIC_KEY__"
Environment="TOKEN=__TOKEN__"
Environment="HUB_URL=__HUB_URL__"
Restart=always
RestartSec=3

# Security/sandboxing settings
KeyringMode=private
LockPersonality=yes
NoNewPrivileges=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
